{"url": "https://data.stats.gov.cn/dg/website/publicrelease/web/external/new/queryIndicatorsByCid?cid=607a7cd4b50e4553894472475d1f4273&dt=2000-2025&name=", "body": null, "retrieved_at": "2026-11-26T11:25:07-0500", "response": {"data": {"total": 6, "list": [{"i_showname": "全社会固定资产投资 (亿元) ", "num_accuracy_text": "2", "_name": "全社会固定资产投资", "ek_dp": "d27216e5d1d74e32812882c86cf9d2dc_1", "kj1_name": null, "dp": "1", "type": "indicator", "is_economy_chart_show_value": "1", "i_annotation": "1995-1996年，除房地产投资、农村集体投资、个人投资以外，投资统计的起点为5万元；自1997年起，除房地产投资、农村集体投资、个人投资以外，投资统计的起点由5万元提高到50万元；自2011年起,除房地产投资、农村个人投资外，固定资产投资的统计起点由50万元提高至500万元。为便于比较，1996、2010年数据作了相应调整。", "ds_order": 1, "du": "7dae305350e74cf793520af55bceffa4", "kj3_name": null, "chart_style_text": null, "ek_dp_name": "全社会固定资产投资_本期", "num_accuracy_value": "2", "chart_style_value": null, "ek_name": "全社会固定资产投资", "dp_name": "本期", "daterange_sdate": null, "is_economy_chart_show_text": "是", "kj2_name": null, "ek": "d27216e5d1d74e32812882c86cf9d2dc", "dead_line_value": null, "kj2": null, "kj1": null, "catalogid": "607a7cd4b50e4553894472475d1f4273", "daterange_edate": null, "kj3": null, "default_indicator_value": null, "i_mark": "全社会固定资产投资是以货币形式表现的在一定时期内全社会建造和购置固定资产的工作量以及与此有关的费用的总称。该指标是反映固定资产投资规模、结构和发展速度的综合性指标，又是观察工程进度和考核投资效果的重要依据。全社会固定资产投资按登记注册类型可分为国有、集体、联营、股份制、私营和个体、港澳台商、外商、其他等。", "_id": "ba8a0fbdae644f44be836143bbc63f4e", "du_name": "亿元"}, {"i_showname": "全社会固定资产投资比上年增长 (%) ", "num_accuracy_text": "1", "_name": "全社会固定资产投资", "ek_dp": "d27216e5d1d74e32812882c86cf9d2dc_11", "kj1_name": null, "dp": "11", "type": "indicator", "is_economy_chart_show_value": "1", "i_annotation": null, "ds_order": 2, "du": "414774dee2bc47f392cf13abfa9de882", "kj3_name": null, "chart_style_text": "折线图", "ek_dp_name": "全社会固定资产投资_同比增减%", "num_accuracy_value": "1", "chart_style_value": "2", "ek_name": "全社会固定资产投资", "dp_name": "同比增减%", "daterange_sdate": null, "is_economy_chart_show_text": "是", "kj2_name": null, "ek": "d27216e5d1d74e32812882c86cf9d2dc", "de