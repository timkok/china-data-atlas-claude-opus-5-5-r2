99ac254437aa5a6cb802e11c3c", "treeinfo_level": 4, "type": "catalog", "edate": "2002", "isLeaf": false, "treeinfo_globalid": "69c574ab128a44e595cc0b24502b771b.884c062607104a91967b22742537f44f.d2053699ac254437aa5a6cb802e11c3c.1eb4a171c7c44b879446c231b4811762", "name": "按行业分大中型工业企业主要经济指标 (2000-2002) ", "_id": "1eb4a171c7c44b879446c231b4811762", "publicrelease_web_catalog_id": "1eb4a171c7c44b879446c231b4811762", "treeinfo_icon": null}, {"explain": null, "sdate": "2003", "_name": "按行业分大中型工业企业主要经济指标 (2003-2011) ", "treeinfo_pid": "d2053699ac254437aa5a6cb802e11c3c", "treeinfo_level": 4, "type": "catalog", "edate": "2011", "isLeaf": false, "treeinfo_globalid": "69c574ab128a44e595cc0b24502b771b.884c062607104a91967b22742537f44f.d2053699ac254437aa5a6cb802e11c3c.7bc6067ce87a46dd8aa2e3576c5597fa", "name": "按行业分大中型工业企业主要经济指标 (2003-2011) ", "_id": "7bc6067ce87a46dd8aa2e3576c5597fa", "publicrelease_web_catalog_id": "7bc6067ce87a46dd8aa2e3576c5597fa", "treeinfo_icon": null}, {"explain": null, "sdate": "2012", "_name": "按行业分大中型工业企业主要经济指标 (2012-2022) ", "treeinfo_pid": "d2053699ac254437aa5a6cb802e11c3c", "treeinfo_level": 4, "type": "catalog", "edate": null, "isLeaf": false, "treeinfo_globalid": "69c574ab128a44e595cc0b24502b771b.884c062607104a91967b22742537f44f.d2053699ac254437aa5a6cb802e11c3c.78623bda934640af934d668a79b5b731", "name": "按行业分大中型工业企业主要经济指标 (2012-2022) ", "_id": "78623bda934640af934d668a79b5b731", "publicrelease_web_catalog_id": "78623bda934640af934d668a79b5b731", "treeinfo_icon": null}, {"explain": null, "sdate": null, "_name": "按行业分大中型工业企业主要经济指标（2023-至今）", "treeinfo_pid": "d2053699ac254437aa5a6cb802e11c3c", "treeinfo_level": 4, "type": "catalog", "edate": null, "isLeaf": false, "treeinfo_globalid": "69c574ab128a44e595cc0b24502b771b.884c062607104a91967b22742537f44f.d2053699ac254437aa5a6cb802e11c3c.47f4742feb1744939303d4ffe55d4053", "name": "按行业分大中型工业企业主要经济指标（2023-至今）", "_id": "47f4742feb1744939303d4ffe55d4053", "publicrelease_web_catalog_id": "47f4742feb1744939303d4ffe55d4053", "treeinfo_icon": null}, {"explain": "从2011年起，规模以上工业企业起点标准由原来的年主营业务收入500万元提高到年主营业务收入2000万元。2023年数据统计范围为规模以上工业企业。\n2018年数据根据全国第四次经济普查结果进行了修订。\n成品糖1997年及以前名称为糖，产量包括土糖，1998-2004年名称为机制糖。\n啤酒2003年及以前计量单位为万吨。\n卷烟2003年及以前计量单位为万箱。\n纱包括棉纱、棉混纺纱、纯化纤纱，不包括棉线、代用纤维纱和手工纺纱。\n从2011年起，规模以上工业企业起点标准由原来的年主营业务收入500万元提高到年主营业务收入2000万元。\n布包括棉布、棉混纺布、纯化纤布，不包括代用纤维布、手工织布。\n农用化肥按有效成分100%计算。\n初级形态的塑料2004年及以前名称为塑料树脂及共聚物，简称塑料。\n橡胶轮胎外胎包括摩托车充气橡胶轮胎外胎。\n发动机2008年及以前名称为内燃机。发动机包括汽车用发动机。\n金属切削机床不包括台钻、砂轮机、抛光机。\n拖拉机是指14.7千瓦及以上的轮式和履带式拖拉机。用本厂自产的拖拉机装配的推土机，只计推土机产量，不计拖拉机产量。\n基本型乘用车（轿车）2008年及以前名称为轿车。\n发电机组（发电设备）指500千瓦以上的水轮发电机组、汽轮发电机和燃气轮发电机等。\n复印和胶版印制设备2008年及以前名称为复印机械。", "sdate": "1998", "_name": "工业产品产量", "treeinfo_pid": "d2053699ac254437aa5a6cb802e11c3c", "treeinfo_level": 4, "type": "catalog", "edate": null, "isLeaf": true, "treeinfo_globalid": "69c574ab128a44e595cc0b24502b771b.884c062607104a91967b22742537f44f.d2053699ac254437aa5a6cb802e11c3c.3da0cb2e9c1a4097a8af9fd825093aee", "name": "工业产品产量", "_id": "3da0cb2e9c1a4097a8af9fd825093aee", "publicrelease_web_catalog_id": "3da0cb2e9c1a4097a8af9fd825093aee", "treeinfo_icon": null}], "success": true, "state": 20000, "message": "成功"}}