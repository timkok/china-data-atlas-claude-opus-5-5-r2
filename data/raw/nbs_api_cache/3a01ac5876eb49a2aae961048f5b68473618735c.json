3d267256af024c6", "publicrelease_web_catalog_id": "7c3480efd5114ac1b3d267256af024c6", "treeinfo_icon": null}, {"explain": "邮政业务总量2000年及以前按1990年不变价格计算，2001-2010年按2000年不变价格计算，2011-2020年按2010年不变价格计算，2021年起按2020年不变价格计算。\n电信业务总量2000年及以前按1990年不变价格计算，2001-2010年按2000年不变价格计算，2011-2015年按2010年不变价格计算，2016-2020年按2015年不变价格计算，2021年起按上年不变价格计算。\n2015年移动电话用户及3G移动电话用户统计口径有调整，与往年不可比。\n邮政业务总量的月度和年度数据均来自国家邮政局。国家邮政局从2023年起，不再发布邮政业务总量数据。", "sdate": null, "_name": "邮电业务量", "treeinfo_pid": "79c5a96c74a14d7ebd3b17d21639a196", "treeinfo_level": 4, "type": "catalog", "edate": null, "isLeaf": true, "treeinfo_globalid": "69c574ab128a44e595cc0b24502b771b.884c062607104a91967b22742537f44f.79c5a96c74a14d7ebd3b17d21639a196.aeb6a15df8174f8eaf8ed66fdda629e9", "name": "邮电业务量", "_id": "aeb6a15df8174f8eaf8ed66fdda629e9", "publicrelease_web_catalog_id": "aeb6a15df8174f8eaf8ed66fdda629e9", "treeinfo_icon": null}, {"explain": "快递业务量2006年及以前为邮政特快专递，2007年起为规模以上(年业务收入200万元以上)快递服务企业，2013年起为获得快递业务经营许可的快递服务企业业务量。", "sdate": null, "_name": "快递业务量", "treeinfo_pid": "79c5a96c74a14d7ebd3b17d21639a196", "treeinfo_level": 4, "type": "catalog", "edate": null, "isLeaf": true, "treeinfo_globalid": "69c574ab128a44e595cc0b24502b771b.884c062607104a91967b22742537f44f.79c5a96c74a14d7ebd3b17d21639a196.a98d2811e2a94e388119c772d19980c8", "name": "快递业务量", "_id": "a98d2811e2a94e388119c772d19980c8", "publicrelease_web_catalog_id": "a98d2811e2a94e388119c772d19980c8", "treeinfo_icon": null}, {"explain": "营业网点1998年及以前为邮电局所，1999-2006年为邮政局所；统计口径从2002年起为邮政局所和邮政代办点，2007年起为规模以上邮政业法人企业办理业务的场所。\n邮路总长度1980年及以前为邮路及农村投递路线总长度之和。", "sdate": null, "_name": "邮政业网点及邮递线路", "treeinfo_pid": "79c5a96c74a14d7ebd3b17d21639a196", "treeinfo_level": 4, "type": "catalog", "edate": null, "isLeaf": true, "treeinfo_globalid": "69c574ab128a44e595cc0b24502b771b.884c062607104a91967b22742537f44f.79c5a96c74a14d7ebd3b17d21639a196.6225770c3ddf42f7973cdae715acbc70", "name": "邮政业网点及邮递线路", "_id": "6225770c3ddf42f7973cdae715acbc70", "publicrelease_web_catalog_id": "6225770c3d