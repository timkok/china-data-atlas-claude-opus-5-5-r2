: "b85b930279a040688e03158e2ee3d60d", "treeinfo_level": 4, "type": "catalog", "edate": null, "isLeaf": true, "treeinfo_globalid": "69c574ab128a44e595cc0b24502b771b.884c062607104a91967b22742537f44f.b85b930279a040688e03158e2ee3d60d.09ac2b6323854202bdd7e6baffcf7222", "name": "黄金和外汇储备", "_id": "09ac2b6323854202bdd7e6baffcf7222", "publicrelease_web_catalog_id": "09ac2b6323854202bdd7e6baffcf7222", "treeinfo_icon": null}, {"explain": "自2011年1月起，人民银行采用国际货币基金组织关于储备货币的定义，不再将其他金融性公司在货币当局的存款计入储备货币。自2011年1月起，境外金融机构在人民银行存款数据计入国外负债项目，不再计入其他存款性公司存款。", "sdate": null, "_name": "货币当局资产负债表", "treeinfo_pid": "b85b930279a040688e03158e2ee3d60d", "treeinfo_level": 4, "type": "catalog", "edate": null, "isLeaf": true, "treeinfo_globalid": "69c574ab128a44e595cc0b24502b771b.884c062607104a91967b22742537f44f.b85b930279a040688e03158e2ee3d60d.78aae4744e0f42418c69d0d50ece5821", "name": "货币当局资产负债表", "_id": "78aae4744e0f42418c69d0d50ece5821", "publicrelease_web_catalog_id": "78aae4744e0f42418c69d0d50ece5821", "treeinfo_icon": null}, {"explain": "2011年企业活期存款改为“单位活期存款”，企业定期存款改为“单位定期存款”，居民储蓄存款改为“个人存款”，与上年统计口径一致。", "sdate": null, "_name": "其他存款性公司资产负债表", "treeinfo_pid": "b85b930279a040688e03158e2ee3d60d", "treeinfo_level": 4, "type": "catalog", "edate": null, "isLeaf": true, "treeinfo_globalid": "69c574ab128a44e595cc0b24502b771b.884c062607104a91967b22742537f44f.b85b930279a040688e03158e2ee3d60d.155cb6f2d44242f89048f3b1ef2f2460", "name": "其他存款性公司资产负债表", "_id": "155cb6f2d44242f89048f3b1ef2f2460", "publicrelease_web_catalog_id": "155cb6f2d44242f89048f3b1ef2f2460", "treeinfo_icon": null}, {"explain": null, "sdate": null, "_name": "外资银行资产负债表", "treeinfo_pid": "b85b930279a040688e03158e2ee3d60d", "treeinfo_level": 4, "type": "catalog", "edate": null, "isLeaf": true, "treeinfo_globalid": "69c574ab128a44e595cc0b24502b771b.884c062607104a91967b22742537f44f.b85b930279a040688e03158e2ee3d60d.3762eb61dc7a4b2fb595b1c9082a29c8", "name": "外资银行资产负债表", "_id": "3762eb61dc7a4b2fb595b1c9082a29c8", "publicrelease_web_catalog_id"