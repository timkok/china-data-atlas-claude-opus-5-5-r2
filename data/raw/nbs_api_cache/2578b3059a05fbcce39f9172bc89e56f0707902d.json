{"url": "https://data.stats.gov.cn/dg/website/publicrelease/web/external/new/queryIndicatorsByCid?cid=e5f37eced5de4d4c815f7ac5f59fc6c2&dt=2000-2025&name=", "body": null, "retrieved_at": "2026-11-26T11:25:24-0500", "response": {"data": {"total": 7, "list": [{"i_showname": "居民消费价格指数 (上年=100) ", "num_accuracy_text": "1", "_name": "居民消费价格指数", "ek_dp": "6021702000012|b50457fdeade41b0ac011456f7ab5e44_1", "kj1_name": "上年=100", "dp": "1", "type": "indicator", "is_economy_chart_show_value": "1", "i_annotation": null, "ds_order": 1, "du": "c52be9e0e1324cd1a5bf521a8fd1564c", "kj3_name": null, "chart_style_text": null, "ek_dp_name": "居民消费价格指数_上年=100_本期", "num_accuracy_value": "1", "chart_style_value": null, "ek_name": "居民消费价格指数_上年=100", "dp_name": "本期", "daterange_sdate": null, "is_economy_chart_show_text": "是", "kj2_name": null, "ek": "6021702000012|b50457fdeade41b0ac011456f7ab5e44", "dead_line_value": null, "kj2": null, "kj1": "6021702000012", "catalogid": "e5f37eced5de4d4c815f7ac5f59fc6c2", "daterange_edate": null, "kj3": null, "default_indicator_value": null, "i_mark": "居民消费价格指数是反映一定时期内城乡居民所购买的生活消费品和服务项目价格变动趋势和程度的相对数，是对城市居民消费价格指数和农村居民消费价格指数进行综合汇总计算的结果。通过该指数可以观察和分析消费品的零售价格和服务项目价格变动对城乡居民实际生活费支出的影响程度。", "_id": "5e3053f110074dcdbcfa3c8428dd1367", "du_name": "无"}, {"i_showname": "城市居民消费价格指数 (上年=100) ", "num_accuracy_text": "1", "_name": "居民消费价格指数", "ek_dp": "107900106541-6021702000012|b50457fdeade41b0ac011456f7ab5e44_1", "kj1_name": "城市", "dp": "1", "type": "indicator", "is_economy_chart_show_value": "1", "i_annotation": null, "ds_order": 2, "du": "c52be9e0e1324cd1a5bf521a8fd1564c", "kj3_name": null, "chart_style_text": null, "ek_dp_name": "居民消费价格指数_城市_上年=100_本期", "num_accuracy_value": "1", "chart_style_value": null, "ek_name": "居民消费价格指数_城市_上年=100", "dp_name": "本期", "daterange_sdate": null, "is_economy_chart_show_text": "是", "kj2_name": "上年=100", "ek": "107900106541-6021702000012|b50457fdeade41b0ac011456f7ab5e44", "dead_line_value": null, "kj2": "6021702000012", "kj1": "107900106541", "catalogid": "e5f37eced5de4d4c815f7ac5f59fc6c2", "daterange_edate": null, "kj3": null, "default_indicator_value": null, "i_mark": "城市居民消费价格指数是反映一定时期内城市居民家庭所购买的生活消费品价格和服务项目价格变动趋势和程度的相对数。通过该指数可以观察和分析消费品的零售价格和服务项目价格变动对城镇居民收入和消费支出的影响。", "_id": "86c8d917c03142288c972dce74e7729f", "du_name": "无"}, {"i_showname": "农村居民消费价格指数 (上年=100) ", "num_accuracy_text": "1", "_name": "居民消费价格指数", "ek_dp": "107900106542-6021702000012|b50457fdeade41b0ac011456f7ab5e44_1", "kj1_name": "农村", "dp": "1", "type": "indicator", "is_economy_chart_show_value": "1", "i_annotation": null, "ds_order": 3, "du": "c52be9e0e1324cd1a5bf521a8fd1564c", "kj3_name": null, "chart_style_text": null, "ek_dp_name": "居民消费价格指数_农村_上年=100_本期", "num_accuracy_value": "1", "chart_style_value": null, "ek_name": "居民消费价格指数_农村_上年=100", "dp_name": "本期", "daterange_sdate": null, "is_economy_chart_show_text": "是", "kj2_name": "上年=100", "ek": "107900106542-6021702000012|b50457fdeade41b0ac011456f7ab5e44", "dead_line_value": null, "kj2": "6021702000012", "kj1": "107900106542", "catalogid": "e5f37eced5de4d4c815f7ac5f59fc6c2", "daterange_edate": null, "kj3": null, "default_indicator_value": null, "i_mark": "农村居民消费价格指数是反映一定时期内农村居民家庭所购买的生活消费品价格和服务项目价格变动趋势和程度的相对数。该指数可以观察农村消费品的零售价格和服务项目价格变动对农村居民收入和生活消费支出的影响。", "_id": "1abed3db82564974984c304a597a0965", "du_name": "无"}, {"i_showname": "商品零售价格指数 (上年=100) ", "num_accuracy_text": "1", "_name": "商品零售价格指数", "ek_dp": "6021702000012|94f98a2254a84459a42151997e92297a_1", "kj1_name": "上年=100", "dp": "1", "type": "indicator", "is_economy_chart_show_value": "1", "i_annotation": null, "ds_order": 4, "du": "414774dee2bc47f392cf13abfa9de882", "kj3_name": null, "chart_style_text": "折线图", "ek_dp_name": "上年=100_商品零售价格指数_本期", "num_accuracy_value": "1", "chart_style_value": "2", "ek_name": "上年=100_商品零售价格指数", "dp_name": "本期", "daterange_sdate": null, "is_economy_chart_show_text": "是", "kj2_name": null, "ek": "6021702000012|94f98a2254a84459a42151997e92297a", "dead_line_value": null, "kj2": null, "kj1": "6021702000012", "catalogid": "e5f37eced5de4d4c815f7ac5f59fc6c2", "daterange_edate": null, "kj3": null, "default_indicator_value": null, "i_mark": "商品零售价格指数是反映一定时期内城乡商品零售价格变动趋势和程度的相对数。商品零售价格的变动与国家的财政收入、市场供需的平衡、消费与积累的比例关系有关。因此，该指数可以从一个侧面对上述经济活动进行观察和分析。1993年及以前，全国商品零售价格指数含农业生产资料价格。", "_id": "23b013d4314947ca9938a19d6754458c", "du_name": "%"}, {"i_showname": "工业生产者出厂价格指数 (上年=100) ", "num_accuracy_text": "1", "_name": "工业生产者出厂价格指数", "ek_dp": "6021702000012|ab3a1ae25fdf45c1a15a30351a869800_1", "kj1_name": "上年=100", "dp": "1", "type": "indicator", "is_economy_chart_show_value": "1", "i_annotation": "国家统计局从2011年1月开始实施新的工业生产者价格统计调查制度方法。\"工业品价格统计\"改称为\"工业生产者价格统计\",将\"工业品出厂价格指数\"改称为\"工业生产者出厂价格指数\"。", "ds_order": 5, "du": "c52be9e0e1324cd1a5bf521a8fd1564c", "kj3_name": null, "chart_style_text": null, "ek_dp_name": "工业生产者出厂价格指数_上年=100_本期", "num_accuracy_value": "1", "chart_style_value": null, "ek_name": "工业生产者出厂价格指数_上年=100", "dp_name": "本期", "daterange_sdate": null, "is_economy_chart_show_text": "是", "kj2_name": null, "ek": "6021702000012|ab3a1ae25fdf45c1a15a30351a869800", "dead_line_value": null, "kj2": null, "kj1": "6021702000012", "catalogid": "e5f37eced5de4d4c815f7ac5f59fc6c2", "daterange_edate": null, "kj3": null, "default_indicator_value": null, "i_mark": "工业生产者出厂价格指数是反映一定时期内全部工业产品出厂价格总水平的变动趋势和程度的相对数，包括工业企业售给本企业以外所有单位的各种产品和直接售给居民用于生活消费的产品。该指数可以观察出厂价格变动对工业总产值及增加值的影响。", "_id": "a867836c8fdc4e2dbf06be1dc87fafc6", "du_name": "无"}, {"i_showname": "工业生产者购进价格指数 (上年=100) ", "num_accuracy_text": "1", "_name": "工业生产者购进价格指数", "ek_dp": "6021702000012|7f7090cb8fed461386283fcd3ef06093_1", "kj1_name": "上年=100", "dp": "1", "type": "indicator", "is_economy_chart_show_value": "1", "i_annotation": "国家统计局从2011年1月开始实施新的工业生产者价格统计调查制度方法。\"工业品价格统计\"改称为\"工业生产者价格统计\",相应地将\"原材料、燃料、动力购进价格指数\"改称为\"工业生产者购进价格指数\"。", "ds_order": 6, "du": "c52be9e0e1324cd1a5bf521a8fd1564c", "kj3_name": null, "chart_style_text": null, "ek_dp_name": "工业生产者购进价格指数_上年=100_本期", "num_accuracy_value": "1", "chart_style_value": null, "ek_name": "工业生产者购进价格指数_上年=100", "dp_name": "本期", "daterange_sdate": null, "is_economy_chart_show_text": "是", "kj2_name": null, "ek": "6021702000012|7f7090cb8fed461386283fcd3ef06093", "dead_line_value": null, "kj2": null, "kj1": "6021702000012", "catalogid": "e5f37eced5de4d4c815f7ac5f59fc6c2", "daterange_edate": null, "kj3": null, "default_indicator_value": null, "i_mark": "工业生产者购进价格指数是反映工业企业作为生产投入，而从物资交易市场和能源、原材料生产企业购买原材料、燃料和动力产品时，所支付的价格水平变动趋势和程度的统计指标，是扣除工业企业物质消耗成本中的价格变动影响的重要依据。目前，我国编制的工业生产者购进价格指数所调查的产品包括燃料动力、黑色金属、有色金属、化工、建材等九大类。", "_id": "a8ecf549d7084e3c9baa18cbcf4e907f", "du_name": "无"}, {"i_showname": "固定资产投资价格指数 (上年=100) ", "num_accuracy_text": "1", "_name": "固定资产投资价格指数", "ek_dp": "6021702000012|678d5166db214a489bc7a480d9d4f4fa_1", "kj1_name": "上年=100", "dp": "1", "type": "indicator", "is_economy_chart_show_value": "1", "i_annotation": null, "ds_order": 7, "du": "c52be9e0e1324cd1a5bf521a8fd1564c", "kj3_name": null, "chart_style_text": null, "ek_dp_name": "固定资产投资价格指数_上年=100_本期", "num_accuracy_value": "1", "chart_style_value": null, "ek_name": "固定资产投资价格指数_上年=100", "dp_name": "本期", "daterange_sdate": null, "is_economy_chart_show_text": "是", "kj2_name": null, "ek": "6021702000012|678d5166db214a489bc7a480d9d4f4fa", "dead_line_value": null, "kj2": null, "kj1": "6021702000012", "catalogid": "e5f37eced5de4d4c815f7ac5f59fc6c2", "daterange_edate": null, "kj3": null, "default_indicator_value": null, "i_mark": "固定资产投资价格指数是反映一定时期内固定资产投资品及取费项目的价格变动趋势和程度的相对数。固定资产投资额是由建筑安装工程投资完成额、设备工器具购置投资完成额和其他费用投资完成额三部分组成的。编制固定资产投资价格指数应首先分别编制上述三部分投资的价格指数，然后采用加权算术平均法求出固定资产投资价格总指数。", "_id": "e12702aae75849e68588b968b3399956", "du_name": "无"}]}, "success": true, "state": 20000, "message": "成功"}}