ge_edate": null, "kj3": null, "default_indicator_value": null, "i_mark": "内河航道里程指在一定时期内，能通航运输船舶及排筏的天然河流、湖泊水库、运河及通航渠道的长度。包括全年季节性通航累计三个月以上的航道，不包括仅供零散流放竹、木排的河道。两省以河为界的航道里程，双方均按一半计算，以免重复。", "_id": "5c8165abc79e4f6ea1630aee7d15dbf3", "du_name": "万公里"}, {"i_showname": "公路里程 (万公里) ", "num_accuracy_text": "2", "_name": "公路里程", "ek_dp": "c53e1a240f1a4b71930cc644c4b1cbd7_1", "kj1_name": null, "dp": "1", "type": "indicator", "is_economy_chart_show_value": "1", "i_annotation": "2004年起内河航道里程为内河航道通航里程数。\n2005年起公路里程包括村道。", "ds_order": 12, "du": "30c9e985428a4170a02f139074aa6e91", "kj3_name": null, "chart_style_text": null, "ek_dp_name": "公路里程_本期", "num_accuracy_value": "2", "chart_style_value": null, "ek_name": "公路里程", "dp_name": "本期", "daterange_sdate": "1979-01-01 00:00:00", "is_economy_chart_show_text": "是", "kj2_name": null, "ek": "c53e1a240f1a4b71930cc644c4b1cbd7", "dead_line_value": null, "kj2": null, "kj1": null, "catalogid": "d180695e985243c994eef6a7c3e58090", "daterange_edate": null, "kj3": null, "default_indicator_value": null, "i_mark": "公路里程指报告期末公路的实际长度。统计范围：包括城间、城乡间、乡（村）间能行驶汽车的公共道路，公路通过城镇街道的里程，公路桥梁长度、隧道长度、渡口宽度。不包括城市街道里程，断头路里程，农（林）业生产用道路里程，工（矿）企业等内部道路里程。统计原则：按已竣工验收或交付使用的实际里程计算；两条或多条公路共同经由同一路段的重复里程，只计算一次。", "_id": "e56b0012f8c94a00bc16b040310561b0", "du_name": "万公里"}, {"i_showname": "等级公路里程 (万公里) ", "num_accuracy_text": "2", "_name": "等级公路里程", "ek_dp": "e31416f649ea4f529a14f381b4157055_1", "kj1_name": null, "dp": "1", "type": "indicator", "is_economy_chart_show_value": "1", "i_annotation": "2004年起内河航道里程为内河航道通航里程数。\n2005年起公路里程包括村道。", "ds_order": 13, "du": "30c9e985428a4170a02f139074aa6e91", "kj3_name": null, "chart_style_text": null, "ek_dp_name": "等级公路里程_本期", "num_accuracy_value": "2", "chart_style_value": null, "ek_name": "等级公路里程", "dp_name": "本期", "daterange_sdate": "1979-01-01 00:00:00", "is_economy_chart_show_text": "是", "kj2_name": null, "ek": "e31416f649ea4f529a14f381b4157055", "dead_line_value": null, "kj2": null, "kj1": null, "catalogid": "d180695e985243c994eef6